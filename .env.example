DATABASE_URL="postgresql://user:password@localhost:5432/rp10fut?schema=public"
# Direct (non-pooled) connection, used only by `prisma migrate deploy` for its
# advisory locks. Locally this can be the same value as DATABASE_URL. On
# Neon/Vercel, the Neon integration sets both automatically (pooled vs
# direct).
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/rp10fut?schema=public"

# NextAuth -- generate a real secret for any non-local environment:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Seed-only bootstrap passwords for the two founding staff accounts
# (general_admin). Used ONLY by `prisma/seed.ts` on first run -- rotate both
# immediately after first login via the admin Users page.
SEED_ADMIN_PASSWORD_1="change-me"
SEED_ADMIN_PASSWORD_2="change-me"
